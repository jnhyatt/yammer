# Build context is the repository root (see quadlet/yammer-server.build's
# SetWorkingDirectory=) so this can COPY server/ without seeing the rest of
# the repo.
FROM docker.io/library/node:24-slim

WORKDIR /app

COPY server/package.json server/package-lock.json ./
RUN npm ci --omit=dev

COPY server/src ./src

# No build step by design (see server/README.md) — Node's type stripping runs
# src/*.ts directly. package.json's "start" script is the source of truth for
# the run command; don't duplicate it here as a CMD ["node", ...] that could
# drift from it.
EXPOSE 8765
CMD ["npm", "start"]
