# Copy to `.env` (gitignored) and fill in. See README.md for the full table of
# variables and their defaults; only the required one is listed here.
#
# Format: KEY=value, one per line. `#` starts a comment. Values may be quoted
# with " ' or ` if they contain a `#` or leading/trailing spaces. Anything
# already set in the real environment wins over this file.

# Shared secret. Must match the server's YAMMER_TOKEN exactly.
YAMMER_TOKEN=

# Where the server is listening. Loopback by default; over Tailscale this is
# the server's tailnet address.
# YAMMER_SERVER_URL=ws://127.0.0.1:8765

# The knob most likely to need tuning by ear: how much audio is dropped from the
# end of the buffer when the stop word fires. Too small and "alexa" reaches
# OpenCode as part of your prompt; too large and it eats the end of your
# sentence.
# YAMMER_WAKE_STOP_TRIM_SECONDS=1.0

# Voice activity detection, used only to delimit an answer to a permission
# prompt. Raise the threshold in a noisy room; raise the pre-roll if the first
# syllable of "approve" is getting clipped.
# YAMMER_VAD_THRESHOLD=0.5
# YAMMER_VAD_SILENCE_SECONDS=0.8
# YAMMER_VAD_PREROLL_SECONDS=0.4

# Substring of the device name, or an index. Unset uses the system default.
# YAMMER_INPUT_DEVICE=
# YAMMER_OUTPUT_DEVICE=
