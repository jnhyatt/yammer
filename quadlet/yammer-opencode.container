[Unit]
Description=Headless OpenCode server for Yammer

[Container]
Image=yammer-opencode.build
ContainerName=yammer-opencode
Network=yammer.network

# The one directory OpenCode can touch. Must match the container-side path
# yammer-server sends as YAMMER_PROJECT_DIR (see yammer-server.container) —
# they're two different containers, so that path only has to make sense
# inside this one.
Volume=%h/yammer:/workspace

# Rootless Podman maps container UID 0 to the invoking host user by default,
# so root here reads/writes these bind mounts as you, not as host root.
# Holds auth.json (provider credentials) plus opencode.db, snapshots, and
# logs — this *is* the same state a host-run `opencode serve` would use, so
# don't run both against it at once (concurrent sqlite writers).
Volume=%h/.local/share/opencode:/root/.local/share/opencode
Volume=%h/.config/opencode:/root/.config/opencode

# No PublishPort: only yammer-server (on the yammer network) needs to reach
# this. It is not meant to be exposed to the host or the LAN.

[Service]
Restart=on-failure

[Install]
WantedBy=default.target
