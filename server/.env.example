# Copy to `.env` (gitignored) and fill in. See README.md for the full table of
# variables and their defaults; only the required ones are listed here.
#
# Format: KEY=value, one per line. `#` starts a comment. Values may be quoted
# with " ' or ` if they contain a `#` or leading/trailing spaces. Anything
# already set in the real environment wins over this file.

# Shared secret. Must match the client's YAMMER_TOKEN exactly.
YAMMER_TOKEN=

# Groq by default (OpenAI-compatible; swapping providers is a base-URL change).
YAMMER_STT_API_KEY=

# OpenRouter by default. Routes the forward-vs-meta-command decision.
YAMMER_ROUTER_API_KEY=

# The only directory OpenCode's filesystem access is scoped to.
YAMMER_PROJECT_DIR=

# Leave both unset to use whatever OpenCode itself defaults to. That default
# has been an unavailable/erroring model before — see README's "OpenCode
# model" section if the server logs an OpenCode error on every forwarded turn.
# opencode/deepseek-v4-flash-free is a known-good pair: verified end to end,
# no extra credentials (uses OpenCode's own built-in provider), no cost.
# YAMMER_OPENCODE_PROVIDER=opencode
# YAMMER_OPENCODE_MODEL=deepseek-v4-flash-free

# The OpenCode agent to prompt. Defaults to `yammer` — the checked-in agent at
# `.opencode/agent/yammer.md` whose whole job is producing speakable output.
# OpenCode's own `build` agent writes for a screen, and Kokoro reads its
# headings, bullets, and file paths out loud. Only change this if you have
# another TTS-aware agent installed.
# YAMMER_OPENCODE_AGENT=yammer

# The approval prompt's voice. Must be audibly different from YAMMER_TTS_VOICE —
# two voices is the user's only cue that they are being asked a question rather
# than answered. Default is British male against the agent's American female.
# YAMMER_SUPERVISOR_VOICE=bm_george
# YAMMER_SUPERVISOR_ANSWER_SECONDS=12
# YAMMER_SUPERVISOR_MAX_ATTEMPTS=3

# Where the workspace registry lives. Defaults to the platform's application
# data directory — ~/.local/share/yammer on Linux — which is almost always what
# you want; set it to run two Yammers against separate state.
# YAMMER_STATE_DIR=

# Podman's rootless REST socket. Required: workspaces are containers, so the
# server exits at startup if it cannot be reached. Defaults to
# $XDG_RUNTIME_DIR/podman/podman.sock. If startup says it is unreachable:
# systemctl --user enable --now podman.socket
# YAMMER_PODMAN_SOCKET=

# The image every workspace runs. Never built on demand — it is Arch plus a
# full `pacman -Syu`, so building it inside `create` would mean a four-minute
# wait. Build it once with the Containerfile in containers/yammer-opencode.
# YAMMER_OPENCODE_IMAGE=localhost/yammer-opencode:latest

# Where workspace working directories live on the host. This is where your
# actual work ends up and where you push from, so it defaults somewhere
# findable rather than under the state directory.
# YAMMER_WORKSPACE_ROOT=~/yammer-workspaces

# The agent definition bind-mounted read-only into every workspace. Defaults to
# this repo's own .opencode/agent/<YAMMER_OPENCODE_AGENT>.md. Editing it needs
# no image rebuild, but does need the workspace restarted.
# YAMMER_AGENT_FILE=

# Provider credentials, mounted read-only into every workspace. The one thing
# workspaces share — the rest of OpenCode's state directory is per workspace.
# YAMMER_OPENCODE_AUTH=~/.local/share/opencode/auth.json

# How long `load` waits for OpenCode inside a container to answer, and how long
# a stop waits before it becomes a kill. A cold container answers in about two
# seconds; the default is loose enough not to punish a slow first start.
# YAMMER_WORKSPACE_READY_SECONDS=60
# YAMMER_WORKSPACE_STOP_SECONDS=10

# Uncomment to see every routing decision and turn transition.
# YAMMER_LOG_LEVEL=debug

# CUDA offload for Kokoro. Requires the onnxruntime-node CUDA EP binaries and
# CUDA/cuBLAS runtime libraries to be present — see README.md's "GPU offload"
# section. Leave unset (cpu) unless you've done that setup.
# YAMMER_TTS_DEVICE=cuda
